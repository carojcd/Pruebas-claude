    "sfx": "python3 scripts/sfx.py public/sfx",
    "render": "remotion render Podcast out/borrador.mp4 --codec h264 --crf 18 --audio-codec aac",
    "plan": "python3 scripts/plan.py src/data/edit.json src/data/blocks.json src/data/plan.json",
    "voz": "python3 scripts/voz.py fuentes/clip.mp4 src/data/edit.json public/voz.wav"
