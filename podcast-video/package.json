  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "transcribir": "node scripts/transcribe.mjs fuentes/clip.mp4 analisis/palabras-ok.json $WHISPER_MODELS spanish",
